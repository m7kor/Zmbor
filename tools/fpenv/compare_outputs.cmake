# Runs the strict and fast-math builds of fp_flag_sensitivity and fails when a compared line differs.
execute_process(COMMAND "${STRICT}" OUTPUT_VARIABLE strict_out RESULT_VARIABLE strict_rc)
execute_process(COMMAND "${FAST}" OUTPUT_VARIABLE fast_out RESULT_VARIABLE fast_rc)
if(NOT strict_rc EQUAL 0 OR NOT fast_rc EQUAL 0)
    message(FATAL_ERROR "fp_flag_sensitivity failed to run (strict ${strict_rc}, fast ${fast_rc})")
endif()
string(REPLACE "\r" "" strict_out "${strict_out}")
string(REPLACE "\r" "" fast_out "${fast_out}")
string(REPLACE "\n" ";" strict_lines "${strict_out}")
string(REPLACE "\n" ";" fast_lines "${fast_out}")
list(LENGTH strict_lines count)
list(LENGTH fast_lines fast_count)
if(NOT count EQUAL fast_count)
    message(FATAL_ERROR "the two builds printed a different number of lines")
endif()
set(failures "")
math(EXPR last "${count} - 1")
foreach(i RANGE ${last})
    list(GET strict_lines ${i} s)
    list(GET fast_lines ${i} f)
    if(s MATCHES "^\\[info\\]")
        message(STATUS "not compared: strict '${s}' / fast '${f}'")
        continue()
    endif()
    if(NOT s STREQUAL f)
        string(APPEND failures "\n  strict: ${s}\n  fast:   ${f}")
    endif()
endforeach()
if(failures)
    message(FATAL_ERROR "PS2 arithmetic depends on the host floating-point mode:${failures}")
endif()
message(STATUS "all compared PS2 arithmetic helpers are independent of the floating-point mode")
